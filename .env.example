# Database (Supabase / PostgreSQL)
# Supabase: use Transaction Pooler URL (port 6543, ?pgbouncer=true) for DATABASE_URL
# and the Direct connection URL (port 5432) for DIRECT_URL (needed for prisma migrate deploy)
DATABASE_URL="postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOURREF.supabase.co:5432/postgres"

# NextAuth v5 — REQUIRED for auth to work
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-random-secret-here"

# Your production URL (no trailing slash)
NEXTAUTH_URL="https://your-project.vercel.app"

# Stripe — required for payments and provider payouts
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Public key exposed to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Supabase Storage — optional. When set, file uploads (chat photos, verification
# docs) are stored for real; when unset, uploads fall back to a placeholder URL.
# SUPABASE_URL is the project URL (https://YOURREF.supabase.co). Use the service
# role key (server-only, never expose to the browser). Create a public bucket
# named "uploads" (or override with SUPABASE_STORAGE_BUCKET).
SUPABASE_URL="https://YOURREF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="uploads"

# Transactional email — required for account verification links and password
# reset. Unset in dev/preview: signups are auto-verified and the forgot-password
# page tells the user reset is unavailable.
# EMAIL_PROVIDER defaults to "resend" as soon as RESEND_API_KEY is present.
EMAIL_PROVIDER="resend"
# Get from https://resend.com/api-keys
RESEND_API_KEY="re_..."
# Verified sender on your domain, e.g. "Aladdin <no-reply@aladdin.lt>"
EMAIL_FROM="Aladdin <no-reply@example.com>"

# Transactional SMS — optional second verification channel (6-digit code).
# When unset, the register page only offers email verification.
# SMS_PROVIDER defaults to "twilio" when the SID + auth token are present.
SMS_PROVIDER="twilio"
# Get from https://console.twilio.com
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
# Sending number in E.164, e.g. "+37060000000"
TWILIO_FROM="+370..."
